---
import Layout from '../layouts/Layout.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';
const asset = (p: string) => `${BASE === '/' ? '' : BASE}/${p}`;

const systems = [
  {
    name: 'Emma',
    kind: 'personal AI OS',
    desc: 'Orchestration, tiered memory, voice, scheduling. The interface, not a chat window.',
    stack: 'Python · FastAPI · Ollama · Vosk',
    url: 'https://github.com/DankChamp/emma',
  },
  {
    name: 'Luna',
    kind: 'coding agent',
    desc: 'Tool calling, sessions, local-first. A harness built around how I actually work.',
    stack: 'Python · SQLAlchemy · LLM APIs',
    url: 'https://github.com/DankChamp/luna',
  },
  {
    name: 'Aqua',
    kind: 'research → automation',
    desc: 'Document ingestion and study tooling, moving toward an automation engine.',
    stack: 'Python · ChromaDB · ONNX',
    url: 'https://github.com/DankChamp/aqua',
  },
  {
    name: 'Nebula',
    kind: 'systems tooling',
    desc: 'A native GTK4 frontend for XBPS. Package management that belongs on Void.',
    stack: 'Rust · GTK 4 · libadwaita',
    url: 'https://github.com/DankChamp/nebula-gtk',
  },
  {
    name: 'ntxt',
    kind: 'realtime comms',
    desc: 'Two-person messaging with presence, voice, and video. Built for one conversation.',
    stack: 'JavaScript · Firebase · WebRTC',
    url: null,
  },
  {
    name: 'DevPair',
    kind: 'collaboration',
    desc: 'Shared task board and AI pair programming for a small team.',
    stack: 'HTML · JavaScript · PHP · Groq',
    url: 'https://github.com/DankChamp/dev-pair',
  },
];

const stack = [
  ['languages', 'Python · Rust · Bash · TypeScript · HTML/CSS'],
  ['systems', 'Void Linux · runit · XBPS · musl · GTK 4 · Docker'],
  ['ai', 'Ollama · local LLMs · tool calling · agents · RAG · ChromaDB'],
  ['backend', 'FastAPI · SQLAlchemy · Postgres · SQLite · WebSockets · Firebase'],
  ['frontend', 'Astro · Tailwind · React · HTMX'],
  ['hardware', 'ThinkPad T490 · ESP32 · Arduino · Raspberry Pi · LoRa'],
];

const timeline = [
  ['now', 'VOIDX branch of PX', 'Building the operating layer, the agents, and the people around them.'],
  ['now', 'PX · III', 'Recombination planned with the other half of PX after a 2.5-year split.'],
  ['recent', 'Local-first AI ecosystem', 'Emma, Luna, and Aqua running on one ThinkPad instead of a rented server.'],
  ['recent', 'Nebula', 'GTK4/libadwaita package manager for Void Linux.'],
  ['earlier', 'PX Organization', 'Two founders, one organization, grown from PS Foundation.'],
  ['earlier', 'Void Linux', 'runit + XBPS as the daily driver. The start of caring about internals.'],
];
---

<Layout title="VOID — student, systems builder, co-founder of PX">
  <!-- hero -->
  <section class="wrap flex min-h-[86vh] flex-col justify-center py-24">
    <div class="reveal">
      <div class="mb-8 flex items-center gap-3">
        <span class="h-px w-8 bg-[var(--accent)]"></span>
        <span class="label">x in the void</span>
      </div>

      <h1 class="font-mono text-[19vw] font-bold leading-[0.82] tracking-[0.02em] sm:text-[13rem]">
        VOID<span class="text-[var(--accent)]">.</span>
      </h1>

      <div class="mt-8 max-w-xl">
        <p class="text-lg text-[var(--fg-2)] sm:text-xl">
          Student. Systems builder. Co-founder of <strong class="font-normal text-[var(--fg)]">PX</strong> and head of
          <strong class="font-normal text-[var(--fg)]">VOIDX</strong> — one of its two halves.
        </p>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#systems" class="btn">systems</a>
        <a href="https://github.com/DankChamp" target="_blank" rel="noopener" class="btn-ghost">github</a>
        <a href="mailto:void@px.org" class="btn-ghost">void@px.org</a>
      </div>

      <div class="mt-16 grid max-w-2xl grid-cols-2 gap-px border border-[var(--line)] bg-[var(--line)] sm:grid-cols-4">
        {[
          ['role', 'co-founder'],
          ['org', 'PX / VOIDX'],
          ['os', 'void linux'],
          ['focus', 'local-first ai'],
        ].map(([k, v]) => (
          <div class="bg-[var(--bg)] px-4 py-4">
            <div class="label mb-1">{k}</div>
            <div class="font-mono text-xs text-[var(--fg)]">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 01 about -->
  <section id="about" class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">01</span>
        <h2>whoami</h2>
      </div>

      <div class="grid gap-12 lg:grid-cols-2">
        <div class="prose-dim reveal">
          <p>
            I learn by <strong>building</strong> — working code first, theory second. I prefer lightweight,
            inspectable, open systems over heavy defaults, and I would rather understand a mechanism than
            accept it.
          </p>
          <p>
            Most of my work sits between <strong>AI systems</strong> and <strong>Linux internals</strong>: agents that
            run on my own machine, tools that replace something I found too heavy, and small experiments that
            teach me how the thing actually works.
          </p>
          <p>
            I care about things that outlive the moment they were made — tools, notes, organizations, and the
            people who can keep them running without me in the room.
          </p>
        </div>

        <div class="terminal reveal">
          <div class="terminal-head">
            <span class="dot bg-[var(--fg-3)]"></span>
            <span class="dot bg-[var(--fg-3)]"></span>
            <span class="dot bg-[var(--accent)]"></span>
            <span class="ml-2 font-mono text-[10px] tracking-[0.2em] text-[var(--fg-3)]">~/.void</span>
          </div>
          <pre class="overflow-x-auto p-5 font-mono text-[12.5px] leading-relaxed text-[var(--fg-2)]"><code>{`role      student · systems builder · co-founder
org       PX  →  VOIDX (the half I lead)
os        Void Linux · runit · XBPS
machine   ThinkPad T490 · i7-8th · 16 GB
focus     local-first AI · Linux internals · Rust
principle if a tool limits me for no reason,
          I want to know what is underneath it`}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 doctrine -->
  <section id="doctrine" class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">02</span>
        <h2>doctrine</h2>
      </div>

      <ol class="max-w-3xl space-y-6">
        {[
          ['Question what exists.', 'Age, popularity, and authority are not arguments.'],
          ['Understand before expanding.', 'Small working parts before enormous architectures.'],
          ['Build alternatives.', 'When a tool refuses to be understood, investigate what it replaced.'],
          ['Make privacy structural.', 'Not a promise — a property of the system.'],
          ['Separate identity from contribution.', 'The work should be able to speak first.'],
          ['Design for continuity.', 'A system that dies with its creator was a demo.'],
          ['Build without guaranteed meaning.', 'The absence of universal purpose does not prevent deliberate creation.'],
        ].map(([title, body], i) => (
          <li class="reveal flex gap-5 border-l border-[var(--line)] pl-5">
            <span class="mt-1 font-mono text-[11px] text-[var(--accent)]">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-[var(--fg-2)]">
              <strong class="font-normal text-[var(--fg)]">{title}</strong> {body}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 03 lineage -->
  <section id="lineage" class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">03</span>
        <h2>lineage</h2>
      </div>

      <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div class="prose-dim reveal">
          <p>
            <strong>PX is two halves. VOIDX is mine.</strong>
          </p>
          <p>
            PX began as PS Foundation and became PX Organization — built by two founders who had worked
            together for years. When one of them left for college, the split was not an ending. It was a
            <strong>2.5-year time skip</strong>: two founders, two branches, growing separately on purpose,
            each proving the model on their own terms.
          </p>
          <p>
            I lead <strong>VOIDX</strong> — half of PX, not a side project and not a sub-brand. The other half
            runs under <strong>Hawk</strong>. The recombination is already planned: not a merger back into the old
            shape, but a <strong>third variant</strong> — the version that only exists because both halves grew up
            first.
          </p>
        </div>

        <div class="reveal">
          <img src={asset('assets/lineage.svg')} alt="PX lineage diagram" class="w-full border border-[var(--line)]" />
          <div class="mt-4 grid grid-cols-3 gap-px border border-[var(--line)] bg-[var(--line)] text-center">
            {[
              ['I', 'hawk'],
              ['II', 'voidx'],
              ['III', 'planned'],
            ].map(([n, who]) => (
              <div class="bg-[var(--bg)] px-2 py-3">
                <div class="font-mono text-[11px] text-[var(--accent)]">{n}</div>
                <div class="label mt-1">{who}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 systems -->
  <section id="systems" class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">04</span>
        <h2>systems</h2>
      </div>

      <div>
        {systems.map((s) => (
          <div class="row-link reveal">
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-3">
                {s.url ? (
                  <a href={s.url} target="_blank" rel="noopener" class="font-mono text-base text-[var(--fg)] hover:text-[var(--accent)]">
                    {s.name}
                  </a>
                ) : (
                  <span class="font-mono text-base text-[var(--fg)]">{s.name}</span>
                )}
                <span class="label">{s.kind}</span>
              </div>
              <p class="mt-1 max-w-xl text-sm text-[var(--fg-3)]">{s.desc}</p>
            </div>
            <div class="shrink-0 text-right font-mono text-[11px] text-[var(--fg-3)]">{s.stack}</div>
          </div>
        ))}
      </div>

      <p class="mt-8 max-w-2xl text-sm text-[var(--fg-3)]">
        Two agents are not three chat windows. Each has its own process, configuration, memory, and job. A
        separate second brain is planned to connect them without collapsing them.
      </p>
    </div>
  </section>

  <!-- 05 stack -->
  <section id="stack" class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">05</span>
        <h2>stack</h2>
      </div>

      <div class="border border-[var(--line)]">
        {stack.map(([k, v], i) => (
          <div class={`grid gap-2 px-5 py-4 sm:grid-cols-[160px_1fr] ${i !== 0 ? 'border-t border-[var(--line)]' : ''}`}>
            <span class="label pt-1">{k}</span>
            <span class="font-mono text-[12.5px] text-[var(--fg-2)]">{v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 timeline -->
  <section id="timeline" class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="num">06</span>
        <h2>signal</h2>
      </div>

      <div class="max-w-3xl">
        {timeline.map(([when, what, desc]) => (
          <div class="reveal grid gap-2 border-b border-[var(--line)] py-5 sm:grid-cols-[90px_1fr]">
            <span class="label pt-1">{when}</span>
            <div>
              <div class="text-[var(--fg)]">{what}</div>
              <p class="mt-1 text-sm text-[var(--fg-3)]">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- contact -->
  <section class="section border-t border-[var(--line)]">
    <div class="wrap">
      <div class="reveal max-w-2xl">
        <p class="label mb-6">07 · contact</p>
        <h2 class="mb-6 font-mono text-3xl leading-tight sm:text-4xl">
          Build something that<br />outlives the conversation.
        </h2>
        <p class="mb-8 text-[var(--fg-2)]">
          Open to collaborations, research, and problems worth understanding. Email is the reliable channel.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="mailto:void@px.org" class="btn">void@px.org</a>
          <a href="https://github.com/DankChamp" target="_blank" rel="noopener" class="btn-ghost">github</a>
          <a href="https://github.com/DankChamp/void" target="_blank" rel="noopener" class="btn-ghost">source</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
